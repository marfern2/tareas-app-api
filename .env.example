POSTGRES_DB=tareas_db
POSTGRES_USER=tareas_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

JWT_SECRET=CAMBIAR_POR_SECRETO_BASE64_SEGURO
# Access token: 1800000 = 30 minutos. Vida corta; la sesion se renueva con el refresh token.
JWT_EXPIRATION=1800000
# Refresh token: vida en dias (por ejemplo 30)
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=https://donit-api.marfern.dev
JWT_AUDIENCE=tareas-app

API_PORT=8080
# Tag de la imagen de la API (GHCR). En produccion se fijara a un SHA corto de 12 caracteres.
API_IMAGE_TAG=master
CORS_ALLOWED_ORIGINS=
SWAGGER_ENABLED=false
