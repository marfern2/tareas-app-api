POSTGRES_DB=tareas_db
POSTGRES_USER=tareas_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA

JWT_SECRET=CAMBIAR_POR_SECRETO_BASE64_USUARIOS
# Access token: 1800000 = 30 minutos. Vida corta; la sesion se renueva con el refresh token.
JWT_EXPIRATION=1800000
# Refresh token: vida en dias (por ejemplo 30)
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=https://donit-api.marfern.dev
JWT_AUDIENCE=tareas-app

JWT_ADMIN_SECRET=CAMBIAR_POR_SECRETO_BASE64_ADMIN_DISTINTO
JWT_ADMIN_EXPIRATION=1800000
JWT_ADMIN_REFRESH_EXPIRATION_DAYS=7
JWT_ADMIN_ISSUER=https://donit-api.marfern.dev
JWT_ADMIN_AUDIENCE=donit-admin

API_PORT=8080
# Tag de la imagen de la API (GHCR). El CD lo fija al SHA completo de 40 caracteres.
API_IMAGE_TAG=master
CORS_ALLOWED_ORIGINS=https://admin-donit.marfern.dev
SWAGGER_ENABLED=false
